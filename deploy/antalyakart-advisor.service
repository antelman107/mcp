[Unit]
Description=AntalyaKart Telegram advisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__DEPLOY_USER__
Group=__DEPLOY_USER__
WorkingDirectory=/var/www/mcp
ExecStart=/var/www/mcp/antalyakart-advisor
Restart=on-failure
RestartSec=2
EnvironmentFile=/var/www/mcp/antalyakart-advisor.env
Environment=BOT_ADDR=127.0.0.1:8091

[Install]
WantedBy=multi-user.target
