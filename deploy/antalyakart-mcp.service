[Unit]
Description=AntalyaKart MCP HTTP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__DEPLOY_USER__
Group=__DEPLOY_USER__
ExecStart=/var/www/mcp/antalyakart-mcp
Restart=on-failure
RestartSec=2
Environment=MCP_ADDR=127.0.0.1:8090

[Install]
WantedBy=multi-user.target
